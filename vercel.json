{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(sitemap|api/sitemap|api/sitemap.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets|sitemap\\.xml|robots\\.txt).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(product|brand|category)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/(products|brands|categories|bootstrap)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/cosmatics",
      "destination": "/api/index.js"
    },
    {
      "source": "/cosmatics/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/applieances",
      "destination": "/api/index.js"
    },
    {
      "source": "/applieances/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/suppliments",
      "destination": "/api/index.js"
    },
    {
      "source": "/suppliments/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/category/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/product/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/brand/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|api/).*)",
      "destination": "/index.html"
    }
  ]
}
